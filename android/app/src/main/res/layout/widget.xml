<?xml version="1.0" encoding="utf-8"?>
<!-- Carbon Copy · W-02 Carbon (dark) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/cc_widget_bg"
    android:clipToOutline="true"
    android:paddingStart="@dimen/cc_pad_h"
    android:paddingEnd="@dimen/cc_pad_h"
    android:paddingTop="@dimen/cc_pad_top"
    android:paddingBottom="0dp">

    <!-- Header (fixed): title + edition, date line, refresh on the right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VC BULLETIN"
                    android:textAllCaps="true"
                    android:textColor="@color/cc_paper"
                    android:textSize="11sp"
                    android:letterSpacing="0.2"
                    android:fontFamily="@font/hanken_grotesk_bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/edition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/cc_signal"
                    android:textSize="13sp"
                    android:fontFamily="@font/dm_mono_medium"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="LOADING…"
                android:textAllCaps="true"
                android:textColor="@color/cc_graphite"
                android:textSize="10sp"
                android:fontFamily="@font/dm_mono_regular"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- 18dp icon inside a 48dp touch area; the negative margins let the
             icon itself sit flush with the top-right of the content area. -->
        <ImageView
            android:id="@+id/refresh"
            android:layout_width="@dimen/cc_touch"
            android:layout_height="@dimen/cc_touch"
            android:layout_marginTop="-15dp"
            android:layout_marginEnd="-15dp"
            android:padding="15dp"
            android:src="@drawable/cc_ic_refresh"
            android:contentDescription="Refresh" />
    </LinearLayout>

    <!-- 2dp light rule under the header (a FrameLayout, since widgets can't use plain Views) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/cc_header_rule"
        android:layout_marginTop="8dp"
        android:background="@color/cc_paper" />

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="FETCHING TODAY'S HEADLINES…"
        android:textColor="@color/cc_graphite"
        android:textSize="10sp"
        android:fontFamily="@font/dm_mono_regular" />
</LinearLayout>

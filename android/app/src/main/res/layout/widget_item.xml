<?xml version="1.0" encoding="utf-8"?>
<!-- One row: 20dp number column, 8dp gap, then headline + meta. 1dp hairline at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingTop="@dimen/cc_row_pad_v"
        android:paddingBottom="@dimen/cc_row_pad_v">

        <TextView
            android:id="@+id/number"
            android:layout_width="@dimen/cc_num_col"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/cc_num_gap"
            android:paddingTop="2dp"
            android:textColor="@color/cc_graphite"
            android:textSize="10sp"
            android:fontFamily="@font/dm_mono_regular"
            android:includeFontPadding="false" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/cc_paper"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.3"
                android:maxLines="3"
                android:ellipsize="end"
                android:fontFamily="@font/hanken_grotesk_medium"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cc_meta_gap"
                android:textColor="@color/cc_graphite"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="@font/dm_mono_regular"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/cc_row_rule"
        android:background="@color/cc_rule" />
</LinearLayout>
